# Copiar para .env.local e preencher. O .env.local nunca vai para o Git.

# Widget de deploy (só em desenvolvimento)
# Personal Access Token do GitHub (scope: repo)
GIT_TOKEN=
# URL do repositório sem o prefixo https:// (ex: github.com/utilizador/reserva-salas.git)
GIT_REPO_URL=
# Autor dos commits
GIT_USER_NAME=
GIT_USER_EMAIL=
